From 99c160ccf9cf12ac25e5501f2493c1919e115d3b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 18:34:29 +0000
Subject: [PATCH] Fix friction, entity double-free, input clearing, key
 mapping; clean manifests; add .gitignore

---
 .gitignore                      |  1 +
 Cargo.toml                      |  2 +-
 engine-ecs/src/entity.rs        | 21 +++++++++++++++++++--
 engine-graphics/Cargo.toml      |  2 +-
 engine-physics/src/collision.rs | 26 ++++++++++++++++++++++++--
 engine/src/lib.rs               | 15 +++++++++++----
 examples/platformer/Cargo.toml  |  1 -
 7 files changed, 57 insertions(+), 11 deletions(-)
 create mode 100644 .gitignore

diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..ea8c4bf
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1 @@
+/target
diff --git a/Cargo.toml b/Cargo.toml
index 6ff613d..9ace0a8 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,11 +1,11 @@
 [workspace]
+# engine-audio is excluded until it is re-enabled (rodio build issues)
 members = [
     "engine-core",
     "engine-ecs",
     "engine-graphics",
     "engine-physics",
     "engine-input",
-    "engine-audio",
     "engine-ui",
     "engine",
     "examples/platformer",
diff --git a/engine-ecs/src/entity.rs b/engine-ecs/src/entity.rs
index e7f4c35..28a8c17 100644
--- a/engine-ecs/src/entity.rs
+++ b/engine-ecs/src/entity.rs
@@ -65,7 +65,9 @@ impl EntityPool {
     }
 
     pub fn deallocate(&mut self, entity: Entity) {
-        if !entity.is_valid() {
+        // Ignore stale or already-freed handles so an id is never pushed onto
+        // the free list twice.
+        if !self.is_alive(entity) {
             return;
         }
 
@@ -74,7 +76,9 @@ impl EntityPool {
             return;
         }
 
-        self.generations[id as usize] = self.generations[id as usize].wrapping_add(1);
+        // Generation 0 is reserved (Entity::new maps it to 1), so skip it on wrap.
+        let next = self.generations[id as usize].wrapping_add(1);
+        self.generations[id as usize] = if next == 0 { 1 } else { next };
         self.free_list.push(id);
     }
 
@@ -117,6 +121,19 @@ impl Default for EntityPool {
 mod tests {
     use super::*;
 
+    #[test]
+    fn test_double_deallocate_does_not_duplicate_ids() {
+        let mut pool = EntityPool::new();
+        let e = pool.allocate();
+        pool.deallocate(e);
+        pool.deallocate(e); // stale handle, must be ignored
+
+        let x = pool.allocate();
+        let y = pool.allocate();
+        assert_ne!(x.id(), y.id());
+        assert!(!pool.is_alive(e));
+    }
+
     #[test]
     fn test_entity_creation() {
         let entity = Entity::new(0, 1);
